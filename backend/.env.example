# ============================
# Cyber-ZONE Backend (.env.example)
# Barcha secretlar faqat environment'da saqlanadi — bu faylga yozilmaydi.
# ============================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/cyber_zone?schema=public"

# JWT
JWT_SECRET="change-this-super-secret-key"
JWT_REFRESH_SECRET="change-this-refresh-secret-key"
ACCESS_TOKEN_EXPIRES="15m"
REFRESH_TOKEN_EXPIRES="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Frontend URL (vergul bilan bir nechta bo'lishi mumkin)
FRONTEND_URLS="http://localhost:3006, http://localhost:3000"

# Server
PORT=5000

# ---------- EMAIL (Nodemailer / SMTP) ----------
# Gmail uchun oddiy Gmail paroli ISHLAMAYDI — App Password oling:
#   https://myaccount.google.com/apppasswords  (2FA yoqilgan bo'lishi kerak)
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT=587
# EMAIL_USE_TLS="true"            # 465-port uchun secure; 587-da STARTTLS ishlatiladi
# EMAIL_USER="your-email@gmail.com"
# EMAIL_PASS="16-belgili-app-password"     # REAL SECRET — .env da, git'da EMAS
# DEFAULT_FROM_EMAIL="Cyber-ZONE <no-reply@yourdomain.com>"
#
# Local debugging (SMTP sozlanmasa email console'ga chiqariladi):
# EMAIL_HOST=""
# EMAIL_PORT=587
# EMAIL_USER=""
# EMAIL_PASS=""

# ---------- TO'LOVLAR ----------
# PAYMENTS_MODE="test"            # production -> real provayderlar, TEST yopiladi
# MIN_DEPOSIT_PERCENT=10          # depozit foizi pastki chegarasi
# CLICK_SERVICE_ID=""
# CLICK_MERCHANT_ID=""
# CLICK_MERCHANT_USER_ID=""
# CLICK_SECRET_KEY=""
# PAYME_MERCHANT_ID=""
# PAYME_MERCHANT_KEY=""
# UZUM_MERCHANT_ID=""
# UZUM_SECRET_KEY=""
# PAYNET_MERCHANT_ID=""
# PAYNET_PASSWORD=""
# PROVIDER_CALLBACK_URL=""        # https://cyberzone-backend-api.onrender.com

# ---------- BIRON QOIDALARI ----------
# Muddati o'tgan to'lanmagan bron avtomatik bekor qilinadigan vaqt (daqiqa)
# UNPAID_BOOKING_TTL_MINUTES=60

# ---------- LOGIN XAVFSIZLIGI (individual, hisob bo'yicha) ----------
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_LOCK_MINUTES="60,120,300,1440"   # 1-soat -> 2-soat -> 5-soat -> 24-soat

# ---------- WEBAUTHN / PASSKEY ----------
# WEBAUTHN_RP_ID="cyber-zone-delta.vercel.app"   # passkey bog'langan frontend domeni
# WEBAUTHN_EXPECTED_ORIGINS="https://cyber-zone-delta.vercel.app,https://frontend-six-bay-25.vercel.app"
# TEMP_PASSWORD_MINUTES=30

# Redis (ixtiyoriy)
REDIS_URL="redis://localhost:6380"

# AI (Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"